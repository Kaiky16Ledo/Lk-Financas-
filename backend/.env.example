PORT=4000
NODE_ENV=production
# Gere uma chave aleatória de pelo menos 64 caracteres hexadecimais (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=substitua-por-uma-chave-secreta-aleatoria-de-pelo-menos-64-caracteres
FRONTEND_ORIGIN=https://seu-dominio.com
DATA_DIR=./data

# Opcional: defina apenas na primeira inicialização (se omitido, senhas aleatórias fortes são geradas em data/PRIMEIRO_ACESSO.txt)
